# ==========================================
# NOISE Music Player - Environment Variables
# ==========================================

# 1. NextAuth Secret (generate one using: npx auth secret)
AUTH_SECRET=your_auth_secret_here

# 2. Spotify Developer Credentials
# Create an app at https://developer.spotify.com/dashboard
# Set Redirect URI to: <YOUR_URL>/api/auth/callback/spotify
# (e.g. http://localhost:3000/api/auth/callback/spotify for local development)
# (e.g. https://your-project.vercel.app/api/auth/callback/spotify for Vercel)
AUTH_SPOTIFY_ID=your_spotify_client_id_here
AUTH_SPOTIFY_SECRET=your_spotify_client_secret_here

# 3. Production Site URL (optional for Vercel, automatically detected)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

